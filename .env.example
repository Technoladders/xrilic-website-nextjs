# PostHog project API key (Project settings in PostHog; starts with phc_). It is public by design.
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud: https://us.i.posthog.com   EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Demo form endpoint (Supabase edge function). Defaults to the production project if unset.
NEXT_PUBLIC_DEMO_ENDPOINT=
